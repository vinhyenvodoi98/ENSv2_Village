# Sepolia RPC endpoint used by Foundry (forge test --fork-url, forge script) and by cast.
SEPOLIA_RPC_URL=

# Private key used to deploy contracts to Sepolia. Never commit the real value.
DEPLOYER_PRIVATE_KEY=

# Private key used by the off-chain agent to sign transactions on Sepolia.
AGENT_PRIVATE_KEY=

# Etherscan API key, used by forge for contract verification.
ETHERSCAN_API_KEY=

# Sepolia RPC endpoint exposed to the Next.js frontend (must be prefixed with NEXT_PUBLIC_ to be
# available client-side).
NEXT_PUBLIC_SEPOLIA_RPC_URL=
