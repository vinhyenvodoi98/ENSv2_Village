    "react-dom": "19.2.8",
    "simplex-noise": "^4.0.3",
    "three": "0.185.1",
    "viem": "^2.56.3",
    "wagmi": "^3.7.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.185.4",
    "eslint": "^9",
